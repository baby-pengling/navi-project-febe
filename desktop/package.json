{
  "name": "navi-desktop",
  "productName": "Navi",
  "version": "0.1.0",
  "private": true,
  "description": "Navi AI assistant for macOS and Windows",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
